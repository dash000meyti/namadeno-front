# "enabled" → every /api/v1 request is answered by the in-browser mock (MSW, src/mocks).
# "disabled" → requests go to NEXT_PUBLIC_API_BASE_URL (the real backend).
NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Artificial latency for mocked responses (ms), to make loading states visible.
NEXT_PUBLIC_MOCK_LATENCY=250
